<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Installs as game/SpideyPC.exe.manifest. The original retail EXE remains
     SHA-256-unchanged. System-DPI awareness matches the former WinMM proxy's
     SetProcessDPIAware() behavior before any game window is created. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity name="SpideyPC" processorArchitecture="x86"
                    type="win32" version="1.0.0.0"/>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
    </windowsSettings>
  </application>
</assembly>
